# ---- EC-Reason-Bench :: API runner config ----
# Copy this file to `.env` (same folder) and fill in. Then run ./run_ablation.sh
# Works with OpenAI, DeepSeek, Qwen-API, Together, Moonshot/Kimi, or any
# OpenAI-compatible chat endpoint.

# REQUIRED: your API key
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY

# OPTIONAL: custom endpoint (leave blank for OpenAI).
#   DeepSeek : https://api.deepseek.com
#   Kimi     : https://api.moonshot.cn/v1
#   DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
#   local vLLM: http://localhost:8000/v1
OPENAI_BASE_URL=

# Model name exactly as the provider expects it
MODEL=gpt-4o-mini

# ---- eval knobs ----
WORKERS=8                          # parallel enzymes (API I/O bound; raise if no rate limits)
LIMIT=0                            # 0 = full split; e.g. 30 for a quick smoke test
SPLITS=30 30-50 price promiscuous  # which CARE test splits to run
CHANNELS=all                       # for run_eval.sh: none|all|subset (esm_knn blast hmmer structure active_site)
MODE=cascade                       # cascade | static
