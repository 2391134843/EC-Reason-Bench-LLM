# ---- EC-Reason-Bench :: local-deployment runner config ----
# Copy to `.env`. Two ways to run a local open model:
#   (A) vLLM server (fast, recommended): ./serve_vllm.sh  then  ./run_ablation.sh
#   (B) direct HuggingFace (simple):     ./run_eval_hf.sh

# Model id (HuggingFace repo or local path)
MODEL=Qwen/Qwen2.5-7B-Instruct

# vLLM server
PORT=8000
TP=1                 # tensor-parallel size (number of GPUs used by one model)
MAX_MODEL_LEN=4096
GPU_MEM_UTIL=0.90

# HuggingFace download mirror (China-friendly; comment out if you have direct HF access)
HF_ENDPOINT=https://hf-mirror.com

# ---- eval knobs ----
WORKERS=16                          # parallel enzymes when talking to the vLLM server
LIMIT=0                             # 0 = full split; e.g. 30 for a quick smoke test
SPLITS=30 30-50 price promiscuous
CHANNELS=all                        # none | all | subset (esm_knn blast hmmer structure active_site)
MODE=cascade
